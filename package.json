{
  "name": "@neurelectra/youtube-captions",
  "version": "0.5.0",
  "description": "YouTube transcript extraction via InnerTube API (no API key required) and channel listing via YouTube Data API v3.",
  "keywords": [
    "youtube",
    "transcript",
    "captions",
    "innertube",
    "subtitles"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/extractors.test.js",
    "test:integration": "node --test test/transcript.test.js",
    "test:channel": "node --test test/channel.test.js",
    "prepublishOnly": "npm run build",
    "publish:all": "npm publish --@neurelectra:registry=https://registry.npmjs.org && npm publish --@neurelectra:registry=https://npm.pkg.github.com"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "https-proxy-agent": "^7.0.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neurelectra/youtube-captions.git"
  }
}
